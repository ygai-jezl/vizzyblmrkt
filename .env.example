# ─────────────────────────────────────────────────────────────────────────────
# vizzybl-marketing — environment template. Copy to .env.local for local dev.
# NEVER commit real secrets. In dev/prod these come from Secret Manager via
# apphosting.yaml, NOT from a checked-in file.
# ─────────────────────────────────────────────────────────────────────────────

# GCP / Firebase project the server talks to. Locally, point at the -dev project
# or the Firestore emulator (see FIRESTORE_EMULATOR_HOST below).
GOOGLE_CLOUD_PROJECT=vizzybl-marketing-dev

# Local dev only: route firebase-admin Firestore + Auth to the local emulators.
# Leave UNSET in deployed environments (App Hosting uses Application Default
# Credentials / the runtime service account — no keys, no JSON files).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public Firebase web config (safe to expose to the browser — these are not secrets).
# Get these from the Firebase console → Project settings → your Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vizzybl-marketing-dev
# Local dev only: point the browser Auth SDK at the Auth emulator.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Admin portal — Google Sign-In access control.
# Allowed Workspace domain(s) (comma-separated) + optional explicit emails.
ADMIN_ALLOWED_DOMAINS=yougrow.ai
ADMIN_ALLOWED_EMAILS=
# Google sign-in domain hint (shows only @yougrow.ai accounts in the chooser).
NEXT_PUBLIC_ADMIN_HD=yougrow.ai
# Tenant/region a newly-approved admin is bootstrapped into on first sign-in.
ADMIN_BOOTSTRAP_TENANT_ID=ten_vzb
ADMIN_BOOTSTRAP_REGION=us

# Transactional email. Provider precedence: Mandrill (MailChimp Transactional)
# → Resend → log. With NO key set, emails are LOGGED (the double opt-in + journey
# flows still work in dev). EMAIL_FROM must be a verified sending domain.
MANDRILL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Vizzybl <noreply@vizzybl.ai>
# Reply-To for MailChimp broadcast campaigns (defaults to EMAIL_FROM's address).
EMAIL_REPLY_TO=
# Custom sending-domain verification (Account Settings → Domains) is driven by the
# Mandrill API via MANDRILL_API_KEY — the DKIM CNAMEs, ownership token, SPF, and
# DMARC records are generated automatically; no extra config is needed.

# MailChimp Marketing — audience sync + newsletters (broadcasts) + journeys. The
# SHARED account is used by default; a tenant can be gated to bring its own (see
# Tenant.mailchimpConfig). The server prefix (e.g. us21) is the API key's suffix;
# set MAILCHIMP_SERVER_PREFIX only to override.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Email delivery worker. Cloud Scheduler calls
# POST /api/admin/email/jobs/process with this value in the X-Worker-Secret header.
EMAIL_WORKER_SECRET=

# Mandrill engagement webhook (opens/clicks → POST /api/webhooks/mandrill). The
# KEY is the per-webhook signing key shown when you add the webhook in the
# Mandrill dashboard; the URL must be the EXACT public webhook URL you registered
# (it is part of the HMAC signature, so it must match byte-for-byte). With either
# unset, the webhook accepts-and-drops (engagement is simply not recorded).
MANDRILL_WEBHOOK_KEY=
MANDRILL_WEBHOOK_URL=

# Agent 3 (Creative Director) — Gemini 3.5 Flash + Vertex Imagen. In prod use the
# Vertex backend via ADC (no key); locally set GEMINI_API_KEY instead. With
# neither configured, Agent 3 falls back to templated copy / no image.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=
# Optional model overrides. Defaults are the single source of truth in
# src/lib/agents/modelConfig.ts — the example values below just mirror them. Set an
# env var to change the deployed model with no code change. NOTE: the embedding
# model (text-embedding-005) is deliberately NOT overridable here — it is pinned in
# src/lib/types/knowledgeBase.ts because it is coupled to the vector index.
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
# PRIVATE GCS bucket for generated hero images. The org enforces uniform
# bucket-level access, so the bucket is NOT public — images are served via
# /api/email-asset/<path> by the runtime SA. Unset → image storage disabled
# (Agent 3 reports it instead of returning a broken link).
EMAIL_ASSET_BUCKET=

# Gemini Live API — post-signup voice conversation. SEPARATE from GEMINI_API_KEY
# above: ephemeral tokens + the Live API are Gemini *Developer API* features and
# are NOT supported on the Vertex backend, so this needs a classic "AIza*" key.
# Unset → the conversation feature is OFF (the token route 503s, the CTA hides).
GEMINI_LIVE_API_KEY=
# Optional Live model override (default in src/lib/agents/modelConfig.ts):
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Canonical platform host every brand's widget loads from by default. The tenant
# is resolved from the ?t= hint, not the host, so one host serves all brands and
# the reCAPTCHA key needs only this domain. MUST be registered on the reCAPTCHA
# key. Leave blank locally to fall back to the request origin. Prod: yougrow.ai.
NEXT_PUBLIC_PLATFORM_ORIGIN=

# reCAPTCHA Enterprise (Phase 1). Site key is public; the API key/assessment
# call runs server-side. Do NOT put the secret key in NEXT_PUBLIC_*.
# Feature-flagged: signup passes through until RECAPTCHA_ENABLED=true.
RECAPTCHA_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=vizzybl-marketing-dev

# Dev-only seed route (POST /api/dev/seed). 404 unless ALLOW_SEED=true; always
# 403 on a *-prod project. Set a secret to gate it.
ALLOW_SEED=false
SEED_SECRET=

# Dashboard root agent (ADK 2.0 on Agent Runtime). The proxy
# (/api/admin/agent/chat) streams from the deployed reasoningEngine. Until
# ROOT_AGENT_RESOURCE_ID is set, the chat returns a "not deployed yet" message.
# ROOT_AGENT_LOCATION is the engine's DEPLOY region. Deploy + obtain the id via
# agents/root_agent/deploy.sh; locally, calling it needs `gcloud auth
# application-default login` and the Vertex AI API enabled.
ROOT_AGENT_LOCATION=us-central1
ROOT_AGENT_RESOURCE_ID=
