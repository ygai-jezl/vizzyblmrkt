# YouGrow settings: every environment variable the app, scripts and worker read.
# For a laptop, `npm run local` writes a ready .env.local for the Firebase emulators,
# so you rarely need this file. Never commit .env.local or real secrets.
# Deployed copies set these in their own apphosting.<environment>.yaml (see the notes in
# apphosting.yaml), with secrets in Secret Manager. docs/self-host.md walks through it, and
# npm run selfhost writes that file for you.
# Switches are on only when set to "true"; anything else (or unset) is off.


# ===== Needed for a local run =====
# The offline demo project, the emulators, who may sign in, and local secrets.

# demo-* projects exist only in the emulators. The three ids must match.
GOOGLE_CLOUD_PROJECT=demo-yougrow
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-yougrow
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Who may sign in to the admin (comma-separated). Domains match the Google account's
# domain. There is no default: with both empty, nobody can sign in.
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_ALLOWED_DOMAINS=
# The brand (tenant id) and region a newly allowed admin lands in on first sign-in.
# No default: unset, sign-in says the workspace isn't set up yet.
ADMIN_BOOTSTRAP_TENANT_ID=ten_demo
ADMIN_BOOTSTRAP_REGION=us
# Shows only accounts from this Google Workspace domain in the sign-in chooser,
# and names it when an account is refused. Leave empty locally.
NEXT_PUBLIC_ADMIN_HD=
# Names a domain in the "access denied" message without limiting the chooser.
NEXT_PUBLIC_ADMIN_SIGNIN_DOMAIN=

# POST /api/dev/seed (demo data). Never "true" in production. SEED_SECRET, when
# set, must be sent as the x-seed-secret header.
ALLOW_SEED=true
SEED_SECRET=

# Where emails link back to and the issuer of signed requests (your app's origin).
EMAIL_LINK_ORIGIN=http://localhost:3002
CONNECT_ISSUER=http://localhost:3002
# Lets the canvas use a fixed key outside production when CANVAS_CONTEXT_SIGNING_KEY is unset.
CANVAS_ALLOW_INSECURE_LOCAL=1

# Secrets. Make each one with: openssl rand -base64 32
# Scheduled work: sent as X-Worker-Secret to /api/admin/lifecycle/tick,
# /api/admin/email/jobs/process and /api/admin/distribute/posts/process.
LIFECYCLE_WORKER_SECRET=
EMAIL_WORKER_SECRET=
DISTRIBUTE_WORKER_SECRET=
# Encryption keys for stored connection secrets and OAuth tokens. Changing one
# makes what it sealed unreadable.
CONNECT_SECRET_ENC_KEY=
SOCIAL_TOKEN_ENC_KEY=
GIT_TOKEN_ENC_KEY=
# Signing keys for unsubscribe links, invite links and canvas sessions.
UNSUBSCRIBE_SIGNING_KEY=
INVITE_LINK_SIGNING_KEY=
CANVAS_CONTEXT_SIGNING_KEY=

# npm run local reads its ports from the shell (not this file), e.g.
# LOCAL_APP_PORT=3005 npm run local. Defaults shown.
# LOCAL_APP_PORT=3002
# LOCAL_FIRESTORE_PORT=8080
# LOCAL_AUTH_PORT=9099
# LOCAL_UI_PORT=4000
# LOCAL_HUB_PORT=4400
# LOCAL_LOGGING_PORT=4500
# LOCAL_FIRESTORE_WS_PORT=9150


# ===== Optional features =====
# Each one adds a feature. Leave it unset to keep that feature off.

# Gemini. A classic key from https://aistudio.google.com/apikey turns on AI writing,
# images and knowledge search on a laptop. Deployed copies use Vertex AI instead
# (see GOOGLE_GENAI_USE_VERTEXAI below).
GEMINI_API_KEY=
# The post-signup voice chat (Gemini Live) needs its own classic key.
GEMINI_LIVE_API_KEY=
# Model overrides. Defaults live in src/lib/agents/modelConfig.ts.
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
# GEMINI_CAROUSEL_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_BLOCK_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_EBOOK_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Email. With no provider key, emails are written to the log instead of sent.
# Mandrill is used first, then Resend.
MANDRILL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Example <noreply@example.com>
# Reply-to for newsletters when the brand sets none (unset: the EMAIL_FROM address).
EMAIL_REPLY_TO=
# Footer Privacy Policy link for older brands that never set their own (unset: empty).
EMAIL_DEFAULT_PRIVACY_URL=
# Mandrill opens and clicks webhook: its signing key and the exact URL you registered.
MANDRILL_WEBHOOK_KEY=
MANDRILL_WEBHOOK_URL=
# Mailchimp audience sync, newsletters and its webhook.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_WEBHOOK_KEY=
# A brand's own Mailchimp key is stored sealed under this root key (its own key, never
# shared with the other *_ENC_KEY roots). Make one with: openssl rand -base64 32
# With the switch on and no root key, saving a brand's own key is refused.
MAILCHIMP_KEY_ENC_KEY=
MAILCHIMP_KEY_SEALED_ENABLED=
# Brands (tenant ids, comma-separated) that share the audience above.
MAILCHIMP_SHARED_AUDIENCE_TENANTS=

# Social posting (X and LinkedIn OAuth apps).
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_WEBHOOK_CONSUMER_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_CM_CLIENT_ID=
LINKEDIN_CM_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202606
# The origin OAuth callbacks return to, when it differs from the request's.
SOCIAL_OAUTH_ORIGIN=

# Reading a connected repo (read-only GitHub App), plus GitHub and GitLab OAuth.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's private key (PEM; \n escapes are fine).
GITHUB_APP_PRIVATE_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GIT_OAUTH_ORIGIN=

# Google Analytics 4 on the public site. DEBUG_MODE sends hits to DebugView only.
NEXT_PUBLIC_GA_ENABLED=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_DEBUG_MODE=

# Feature switches. apphosting.yaml lists every one, off. npm run local turns on each
# *_ENABLED one listed there (except RECAPTCHA_ENABLED). NEXT_PUBLIC_* ones are read at build time.
# Admin navigation and help
NEXT_PUBLIC_NAV_V2_ENABLED=
NEXT_PUBLIC_NAV_V2_PHASE2_ENABLED=
NEXT_PUBLIC_NAV_V2_PHASE3_ENABLED=
NEXT_PUBLIC_NAV_V2_PHASE4_ENABLED=
NEXT_PUBLIC_THEME_SWITCH_ENABLED=
NEXT_PUBLIC_INSIGHTS_HUB_ENABLED=
NEXT_PUBLIC_HELP_PAGES_ENABLED=
NEXT_PUBLIC_SETUP_GUIDE_ENABLED=
# Setup steps must be done in order.
ORDER_GUARDS_ENABLED=
# Public site. SITE_HOME_ENABLED makes / the YouGrow marketing homepage; off, / is a
# plain front page with a sign-in button. Then search engine files, the growth loop
# pages and other languages.
SITE_HOME_ENABLED=
SITE_SEO_ENABLED=
SITE_LOOP_ENABLED=
SITE_LANGUAGES_ENABLED=
# The site's canonical origin for links, robots.txt and the homepage widget, e.g.
# https://www.example.com (unset: NEXT_PUBLIC_PLATFORM_ORIGIN, else this host).
NEXT_PUBLIC_SITE_ORIGIN=
# The waitlist campaign (its slug) the marketing homepage embeds (unset: no widget).
SITE_WAITLIST_CAMPAIGN=
DEVELOPERS_DOCS_ENABLED=
# Waitlists and invites
INVITES_ENABLED=
NEXT_PUBLIC_INVITES_ENABLED=
# Waitlist journeys on the lifecycle engine, the tenants that may use it ("*" for all),
# and its screens.
WAITLIST_ENGINE_ENABLED=
WAITLIST_ENGINE_PILOT_TENANTS=
NEXT_PUBLIC_WAITLIST_ENGINE_UI_ENABLED=
# Pausing a waitlist journey holds people instead of ending their sequence.
WAITLIST_JOURNEY_HOLD_ON_PAUSE=
# Retire the original waitlist journey editor: read_only, then retired.
WAITLIST_LEGACY_EDITOR=
# Lifecycle journeys for connected products, and API v2 (/api/v2/users).
LIFECYCLE_ENABLED=
NEXT_PUBLIC_LIFECYCLE_ENABLED=
API_V2_ENABLED=
# Highest delivery mode any product journey send may use: test, shadow or live (unset: test).
LIFECYCLE_MODE_CEILING=
LIFECYCLE_AI_DRAFTS_ENABLED=
LIFECYCLE_CHAT_AUTHORING_ENABLED=
LIFECYCLE_JOURNEY_LINKS_ENABLED=
LIFECYCLE_CONSENT_AT_SEND=
LIFECYCLE_GO_LIVE_SWEEP=
LIFECYCLE_OPT_IN_AFTER_SIGNUP=
LIFECYCLE_SEND_TRACKING=
# Date facts and "quiet for X days" journey starts (the second needs the first).
CONNECT_DATE_FACTS=
LIFECYCLE_DATE_START=
CONNECT_ENTITIES_ENABLED=
CONNECT_QUIET_UNCHANGED_WRITES=
CONNECT_SUPPRESSION_WEBHOOK_ENABLED=
CATALOG_HISTORY_ENABLED=
# The person view, and Vizzy reading one person and drafting a plan.
AUDIENCE_PERSON_VIEW=
LIFECYCLE_PERSON_BRIEF=
LIFECYCLE_PERSON_PLANS=
# Brand kit
BRAND_KIT_ENABLED=
NEXT_PUBLIC_BRAND_KIT_ENABLED=
BRAND_KIT_LOGOS_ENABLED=
NEXT_PUBLIC_BRAND_KIT_LOGOS_ENABLED=
BRAND_COLORS_ENABLED=
NEXT_PUBLIC_BRAND_COLORS_ENABLED=
BRAND_FONTS_ENABLED=
NEXT_PUBLIC_BRAND_FONTS_ENABLED=
BRAND_ASSETS_ENABLED=
NEXT_PUBLIC_BRAND_ASSETS_ENABLED=
BRAND_ASSET_REFS_ENABLED=
BRAND_VOICE_ENABLED=
NEXT_PUBLIC_BRAND_VOICE_ENABLED=
BRAND_STYLE_LOOP_ENABLED=
BRAND_STYLE_REFS_ENABLED=
# Generate several images and keep the best (2 to 4).
BRAND_BEST_OF_N=
BRAND_BEST_OF_N_COUNT=2
BRAND_NOTES_ENABLED=
NEXT_PUBLIC_BRAND_NOTES_ENABLED=
BRAND_NOTES_CHAT_ENABLED=
# Brand map (Wikidata lookups send only the name looked up to www.wikidata.org).
BRAND_MAP_ENABLED=
NEXT_PUBLIC_BRAND_MAP_ENABLED=
BRAND_MAP_RESEARCH_ENABLED=
BRAND_MAP_WIKIDATA_ENABLED=
BRAND_MAP_PAGES_ENABLED=
BRAND_MAP_CHAT_ENABLED=
BRAND_MAP_SCALE_ENABLED=
BRAND_MAP_SITUATIONS_ENABLED=
BRAND_MAP_IMPORT_ENABLED=
# Brand image style: Brand, Image style, the style picker on every image, templates,
# screenshots and learning per style. Off, images are made exactly as before.
BRAND_IMAGE_STYLE_ENABLED=
NEXT_PUBLIC_BRAND_IMAGE_STYLE_ENABLED=
# Fonts found on the brand's website for images (needs the image style; requests go to
# the site and to Google Fonts). Off, uploaded fonts, then the bundled ones.
BRAND_IMAGE_STYLE_SITE_FONTS_ENABLED=
NEXT_PUBLIC_BRAND_IMAGE_STYLE_SITE_FONTS_ENABLED=
# Content
CREATE_BLOG_CITABLE_ENABLED=
NEXT_PUBLIC_BLOG_CITABLE_ENABLED=
CREATE_BLOG_CITE_SOURCES_ENABLED=
NEXT_PUBLIC_BLOG_CITE_SOURCES_ENABLED=
CREATE_BLOG_BRAND_MAP_ENABLED=
CREATE_BLOG_EDITORIAL_ENABLED=
CREATE_SUGGEST_ANGLE_ENABLED=
# A hero image for every blog article (needs the image style and CREATE_BLOG_CITABLE_ENABLED).
BLOG_HERO_ENABLED=
NEXT_PUBLIC_BLOG_HERO_ENABLED=
CREATE_EBOOK_ENABLED=
NEXT_PUBLIC_EBOOK_ENABLED=
CREATE_SOCIAL_IMAGE_ENABLED=
NEXT_PUBLIC_SOCIAL_IMAGE_ENABLED=
CONTENT_CHAT_AUTHORING_ENABLED=
CONTENT_STEERING_ENABLED=
NEXT_PUBLIC_CONTENT_STEERING_ENABLED=
# Gemini thinking budgets for blog research, writing and checking.
# BLOG_RESEARCH_THINKING_BUDGET=1024
# BLOG_WRITER_THINKING_BUDGET=2048
# BLOG_CHECKER_THINKING_BUDGET=4096
# Knowledge search grounds AI writing in the brand's sources.
KNOWLEDGE_RAG_ENABLED=
# KNOWLEDGE_MAX_ACTIVE_INGESTIONS=10
# Email style
EMAIL_STYLE_ENABLED=
NEXT_PUBLIC_EMAIL_STYLE_ENABLED=
EMAIL_HEADER_OPTIONS_ENABLED=
NEXT_PUBLIC_EMAIL_HEADER_OPTIONS_ENABLED=
EMAIL_THEMES_ENABLED=
EMAIL_WEB_FONTS_ENABLED=
EMAIL_LAYOUT_STYLE_ENABLED=
EMAIL_STYLE_TRANSACTIONAL_ENABLED=
EMAIL_JOURNEY_STYLE_ENABLED=
# Social distribution and what it learns from post results
DISTRIBUTE_SOCIAL_ENABLED=
DISTRIBUTE_CAROUSEL_ENABLED=
DISTRIBUTE_CLOSED_LOOP_ENABLED=
HASHTAG_LEADERBOARD_ENABLED=
POST_PATTERNS_LEARN_ENABLED=
POST_PATTERNS_INJECT_ENABLED=
TRENDING_TOPICS_ENABLED=
GIT_REPO_SELECTION_ENABLED=
# Tuning for the above (defaults shown).
# DISTRIBUTE_EXEMPLAR_MIN_LIKES=25
# POST_PATTERNS_HOLDOUT_PCT=15
# TRENDING_REFRESH_MS=172800000
# TRENDING_TTL_MS=259200000
# POST_REWARD_W_LIKES=1.0
# POST_REWARD_W_COMMENTS=3.0
# POST_REWARD_W_SHARES=4.0
# POST_REWARD_W_CLICKS=1.5
# POST_REWARD_SIM_DUP=0.92
# POST_REWARD_SIM_NOVEL=0.85
# POST_REWARD_REACH_FLOOR=200
# POST_REWARD_MIN_ACTIONS=5
# POST_REWARD_MIN_BASELINE=3
# POST_REWARD_EXEMPLAR_MIN=0.25
# POST_REWARD_PROMOTE_K=3
# POST_REWARD_PROMOTE_R=0.3
# POST_REWARD_PROMOTE_DAYS=3
# POST_REWARD_PRIOR_N0=5
# Analytics from BigQuery (needs the datasets below).
ANALYTICS_BQ_ENABLED=
NEXT_PUBLIC_ANALYTICS_BQ_ENABLED=


# ===== Deploy only =====
# For a real Google Cloud project. A local run needs none of these.

# Firebase web config from the console (public values, not secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Gemini and embeddings on Vertex AI with the runtime service account. Leave these
# unset on a laptop, where GEMINI_API_KEY is used instead.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=global
# Regional embedding locations, so text stays in its region.
# EMBEDDINGS_LOCATION_US=us-central1
# EMBEDDINGS_LOCATION_EU=europe-west4
# EMBEDDINGS_LOCATION_ASIA=asia-southeast1
# Cloud KMS key that signs requests to connected products:
# projects/<project>/locations/<region>/keyRings/<ring>/cryptoKeys/<key>
CONNECT_SIGNING_KMS_KEY=
# The canonical public origin (e.g. https://app.example.com; empty locally: the request's
# origin is used), and other domains the platform owns (comma-separated).
NEXT_PUBLIC_PLATFORM_ORIGIN=
PLATFORM_RESERVED_DOMAINS=
# reCAPTCHA Enterprise on waitlist sign-ups.
RECAPTCHA_ENABLED=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
# BigQuery datasets per region (for ANALYTICS_BQ_ENABLED).
BQ_DATASET_US=
BQ_DATASET_EU=
BQ_DATASET_ASIA=
# Private Cloud Storage buckets for generated images and the audit log.
EMAIL_ASSET_BUCKET=
AUDIT_LOG_BUCKET=
# The knowledge worker (a Cloud Run job) and the Vizzy agent (Agent Runtime).
KNOWLEDGE_JOB_NAME=knowledge-scraper
KNOWLEDGE_JOB_LOCATION=us-central1
ROOT_AGENT_LOCATION=us-central1
ROOT_AGENT_RESOURCE_ID=
# The previous invite signing key, so links signed before a rotation still work.
INVITE_LINK_SIGNING_KEY_PREVIOUS=
# npm run seed only seeds demo-* projects unless this is "true"; a *-prod project
# also needs ALLOW_PROD_SEED=true.
ALLOW_REAL_PROJECT_SEED=
ALLOW_PROD_SEED=

# Read by the knowledge worker job (workers/knowledge-scraper), set on the job:
# SCRAPER_USER_AGENT=YouGrowBot/1.0 (+https://example.com/bot)   (default: YouGrowBot/1.0)
# KNOWLEDGE_EMBED_CONCURRENCY=6
# KNOWLEDGE_MAX_PAGES=20
# PRODUCT_MAP_LOCATION, PRODUCT_MAP_MODEL, and per region PRODUCT_MAP_LOCATION_US/_EU/_ASIA
# and PRODUCT_MAP_MODEL_US/_EU/_ASIA
# GIT_TOKEN_GITHUB, GIT_TOKEN_GITLAB (fallback repo tokens)
# Set by the app on each worker run, never by hand: JOB_KIND, TICKET_ID, TENANT_ID,
# OWNER_KIND, OWNER_ID, REGION, INGEST_SOURCE, SOURCE_URI, INGEST_REF, INCLUDE_GLOBS,
# TOPIC, TAGS, ANALYSIS_ID, DATE_FACTS.
# NODE_ENV is set by Next.js. PORT, when the host sets it, is the local signing issuer's port.
