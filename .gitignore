# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets — this repo is PUBLIC). Every .env variant is
# ignored; only the value-free template is tracked.
.env*
!.env.example

# private keys / certificates / credential bundles
*.pem
*.p12
*.pfx
*.key
credentials*.json
firebase-adminsdk*.json

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
*-service-account*.json
serviceAccount*.json

# typescript
*.tsbuildinfo

# editor
.idea/
.vscode/*
!.vscode/extensions.json

# claude code local (personal) settings
.claude/settings.local.json

# Python virtualenvs (e.g. agents/*/.venv) + bytecode caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
