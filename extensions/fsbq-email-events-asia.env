# firebase/firestore-bigquery-export@0.3.2 — email_events in asia (DB signups-asia @ asia-southeast1) -> waitlist_asia.email_events_raw_*
# Trigger region derives from DATABASE_REGION (0.3.x: triggerRegion=${DATABASE_REGION}).
COLLECTION_PATH=email_events
DATABASE=signups-asia
DATABASE_REGION=asia-southeast1
DATASET_ID=waitlist_asia
DATASET_LOCATION=asia-southeast1
TABLE_ID=email_events
WILDCARD_IDS=false
BIGQUERY_PROJECT_ID=vizzybl-marketing-dev
