# firebase/firestore-bigquery-export@0.3.2 — signups in asia (DB signups-asia @ asia-southeast1) -> waitlist_asia.signups_raw_*
# Trigger region derives from DATABASE_REGION (0.3.x: triggerRegion=${DATABASE_REGION}).
COLLECTION_PATH=signups
DATABASE=signups-asia
DATABASE_REGION=asia-southeast1
DATASET_ID=waitlist_asia
DATASET_LOCATION=asia-southeast1
TABLE_ID=signups
WILDCARD_IDS=false
BIGQUERY_PROJECT_ID=vizzybl-marketing-prod
