# firebase/firestore-bigquery-export@0.3.2 — signups in eu (DB signups-eu @ eur3) -> waitlist_eu.signups_raw_*
# Trigger region derives from DATABASE_REGION (0.3.x: triggerRegion=${DATABASE_REGION}).
COLLECTION_PATH=signups
DATABASE=signups-eu
DATABASE_REGION=eur3
DATASET_ID=waitlist_eu
DATASET_LOCATION=eu
TABLE_ID=signups
WILDCARD_IDS=false
BIGQUERY_PROJECT_ID=vizzybl-marketing-dev
