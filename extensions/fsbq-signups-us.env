# firebase/firestore-bigquery-export@0.3.2 — signups in us (DB (default) @ nam5) -> waitlist_us.signups_raw_*
# Trigger region derives from DATABASE_REGION (0.3.x: triggerRegion=${DATABASE_REGION}).
COLLECTION_PATH=signups
DATABASE=(default)
DATABASE_REGION=nam5
DATASET_ID=waitlist_us
DATASET_LOCATION=us
TABLE_ID=signups
WILDCARD_IDS=false
BIGQUERY_PROJECT_ID=vizzybl-marketing-prod
