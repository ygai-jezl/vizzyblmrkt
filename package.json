{
  "name": "vizzybl-marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "smoke": "firebase emulators:exec --config firebase.integration.json --project demo-vizzybl 'bash scripts/smoke.sh'",
    "emulators": "firebase emulators:start --only firestore,auth"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "@google-cloud/run": "^3.3.0",
    "@google/genai": "^2.8.0",
