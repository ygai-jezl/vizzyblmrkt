{
  "name": "vizzybl-marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "smoke": "firebase emulators:exec --config firebase.integration.json --project demo-vizzybl 'bash scripts/smoke.sh'",
    "emulators": "firebase emulators:start --only firestore,auth"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@xyflow/react": "^12.11.0",
    "firebase": "^10.13.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^9.15.0",
    "lucide-react": "^0.562.0",
    "next": "^15.5.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "~3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
