{
  "name": "@yougrowai/node",
  "version": "0.2.0",
  "description": "Send your product's user events to YouGrow lifecycle journeys, and answer its signed context and webhook requests.",
  "license": "MIT",
  "author": "YouGrow.AI Limited",
  "homepage": "https://yougrow.ai/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygai-jezl/vizzyblmrkt.git",
    "directory": "sdk/node"
  },
  "keywords": ["yougrow", "lifecycle-email", "onboarding", "events", "webhooks", "jwks"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./server": {
      "import": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
      "require": { "types": "./dist/cjs/server.d.ts", "default": "./dist/cjs/server.js" }
    }
  },
  "typesVersions": {
    "*": { "server": ["./dist/cjs/server.d.ts"] }
  },
  "files": ["dist", "test/vectors.json", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepack": "npm run build"
  }
}
