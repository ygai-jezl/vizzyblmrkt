{
  "name": "knowledge-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Run Job: ingest docs/site/repo sources → semantic chunks → Vertex embeddings → Firestore vectors.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "node-html-parser": "^6.1.13",
    "playwright": "^1.49.0",
    "turndown": "^7.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "fsevents": false
  }
}
